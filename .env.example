# Токен бота, полученный от @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# База данных (SQLite по умолчанию, файл создастся автоматически)
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# Часовой пояс по умолчанию (можно поменять и в веб-панели)
TIMEZONE=Europe/Moscow

# Доступ в веб-панель (поменяйте на свои значения!)
ADMIN_USERNAME=parent
ADMIN_PASSWORD=change-me-please

# Случайная строка для подписи сессии веб-панели (поменяйте на свою!)
SESSION_SECRET_KEY=change-me-to-a-long-random-string

# На каком хосте/порту слушает веб-панель
WEB_HOST=0.0.0.0
WEB_PORT=8000

# Ключ Anthropic API — нужен только если включаете ИИ-собеседника в Настройках.
# Получить можно на https://console.anthropic.com (платно, по использованию).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Ключ Groq API — нужен только для распознавания ГОЛОСОВЫХ сообщений (Whisper).
# Отдельный от Anthropic сервис, есть бесплатный тариф, карта не нужна. Получить на https://console.groq.com/keys
# Без него ИИ-собеседник всё равно работает, просто не понимает голосовые — только текст.
GROQ_API_KEY=
