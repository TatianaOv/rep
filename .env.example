# Токен бота, полученный от @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# База данных (SQLite по умолчанию, файл создастся автоматически)
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# Часовой пояс по умолчанию (можно поменять и в веб-панели)
TIMEZONE=Europe/Moscow

# Доступ в веб-панель (поменяйте на свои значения!)
ADMIN_USERNAME=parent
ADMIN_PASSWORD=change-me-please

# Случайная строка для подписи сессии веб-панели (поменяйте на свою!)
SESSION_SECRET_KEY=change-me-to-a-long-random-string

# На каком хосте/порту слушает веб-панель
WEB_HOST=0.0.0.0
WEB_PORT=8000
